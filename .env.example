APP_ENV=development
DATABASE_URL=sqlite:///./saathi.db
TIMEZONE=Asia/Kolkata
SHARED_SECRET=change-me            # header X-Saathi-Key; empty disables auth in dev
CORS_ORIGINS=http://localhost:5173
TELEGRAM_BOT_TOKEN=                # optional; empty = console notifier
MISSED_DOSE_MINUTES=60
LLM_PROVIDER=rules                 # rules | gemini | groq
GEMINI_API_KEY=
GROQ_API_KEY=
MCP_PUBLIC_URL=http://localhost:8000/mcp
VITE_API_BASE_URL=http://localhost:8000
VITE_SHARED_SECRET=change-me       # demo only: anything in a browser bundle is public
MCP_LOCAL_URL=                     # optional: URL the built-in simulator uses to reach /mcp
GEMINI_MODEL=gemini-2.0-flash
GROQ_MODEL=llama-3.3-70b-versatile
